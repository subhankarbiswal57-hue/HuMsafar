NODE_ENV=development
PORT=4000

# Postgres connection (Neon Serverless Postgres or Local Docker Compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/infra_platform?schema=public"

# JWT secrets - generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-32-chars-long"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Frontend origin allowed for CORS + cookies
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
APP_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000

# Cloudinary / S3 Storage CDN (Optional, falls back to local /uploads/ directory)
# STORAGE_CDN_URL=https://res.cloudinary.com/your-cloud/image/upload

# Google OAuth (Register client credentials at console.cloud.google.com)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# SMTP (Optional in dev - emails are logged to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@infra-platform.local
