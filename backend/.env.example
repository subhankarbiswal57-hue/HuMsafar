NODE_ENV=development
PORT=4000

# Postgres connection (Neon or local docker-compose db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/infra_platform?schema=public"

# JWT secrets - generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Frontend origin allowed for CORS + cookies
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
APP_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000

# SMTP (optional in dev - emails are logged to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@infra-platform.local
